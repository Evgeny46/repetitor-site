6:["$","main",null,{"className":"resources-page","children":[["$","$L7",null,{}],["$","div",null,{"className":"resource-intro shell","children":["$","nav",null,{"className":"built-breadcrumb","aria-label":"Хлебные крошки","children":[["$","a",null,{"href":"/repetitor-site/bazadom/","children":"Главная"}],["$","span",null,{"aria-hidden":"true","children":"/"}],["$","a",null,{"href":"/repetitor-site/bazadom/poleznoe","children":"Полезное"}],["$","span",null,{"aria-hidden":"true","children":"/"}],["$","span",null,{"aria-current":"page","children":"Как выбрать проект дома"}]]}]}],["$","article",null,{"className":"helpful-article shell","children":[["$","header",null,{"className":"article-header","children":[["$","p",null,{"className":"resource-category","children":"Выбор проекта"}],["$","h1",null,{"children":"Как выбрать проект дома"}],["$","p",null,{"className":"article-lead","children":"С чего начать выбор, как оценить планировку и что обсудить до адаптации проекта под участок."}]]}],["$","div",null,{"className":"article-layout","children":[["$","div",null,{"className":"article-body","children":[[["$","section","Начните с того, как вы будете жить",{"children":[["$","h2",null,{"children":"Начните с того, как вы будете жить"}],["$","p",null,{"children":"Перед просмотром проектов запишите, кто будет жить в доме постоянно, как часто приезжают гости и какие занятия требуют отдельного пространства. Так легче оценивать планировку по своим привычкам."}],["$","ul",null,{"children":[["$","li","Сколько нужно спален, санузлов и рабочих мест",{"children":"Сколько нужно спален, санузлов и рабочих мест"}],["$","li","Нужна ли спальня на первом этаже",{"children":"Нужна ли спальня на первом этаже"}],["$","li","Где хранить сезонные вещи, инструменты и спортивный инвентарь",{"children":"Где хранить сезонные вещи, инструменты и спортивный инвентарь"}],["$","li","Как связать кухню, гостиную и выход на участок",{"children":"Как связать кухню, гостиную и выход на участок"}]]}]]}],["$","section","Сравнивайте планировки, а не только фасады",{"children":[["$","h2",null,{"children":"Сравнивайте планировки, а не только фасады"}],["$","p",null,{"children":"Красивое изображение помогает выбрать направление архитектуры, но не показывает, насколько удобен дом внутри. Смотрите, как расположены помещения, сколько места занимают коридоры, где находятся лестница и хозяйственные зоны. Мысленно пройдите обычный день: от входа в дом с покупками до вечернего отдыха."}],"$undefined"]}],["$","section","Проверьте, подходит ли проект участку",{"children":[["$","h2",null,{"children":"Проверьте, подходит ли проект участку"}],["$","p",null,{"children":"Понравившийся дом нужно сопоставить с конкретным участком: его формой, рельефом, подъездом, расположением соседних домов и доступными коммуникациями. Передайте проектировщику адрес или кадастровый номер и имеющиеся документы. Возможность размещения и необходимые изменения определяют после изучения исходных данных."}],"$undefined"]}],["$","section","Уточните состав проекта и строительства",{"children":[["$","h2",null,{"children":"Уточните состав проекта и строительства"}],["$","p",null,{"children":"Выясните, какие чертежи входят в проект и что потребуется дополнительно для расчёта и работ. Обсудите желаемый результат строительства: стены, кровлю и окна, готовность к отделке или более полный состав. Это поможет сравнивать предложения с одинаковым объёмом работ."}],"$undefined"]}]],["$","aside",null,{"className":"article-takeaway","aria-label":"С чего начать","children":["$","p",null,{"children":"Для первого разговора достаточно пожеланий к дому, примерного бюджета и информации об участке, которая уже есть. Если точного решения пока нет, начнём с его выбора."}]}],["$","div",null,{"className":"article-actions","children":[["$","$L8",null,{"label":"Обсудить свой дом","service":"Как выбрать проект дома"}],["$","a",null,{"className":"resource-read","href":"/repetitor-site/bazadom/uslugi/proektirovanie-domov","children":["Как проходит проектирование"," ","$L9"]}]]}]]}],"$La"]}]]}],"$Lb"]}]
